#!/bin/sh
# `web` launcher. While the agent-web plugin is enabled, Claude Code puts this directory on the Bash
# tool's PATH. Runs the package from this checkout with uv, in its own runtime environment
# (separate from the development .venv) built from the locked dependencies.
set -e
root=$(CDPATH='' cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
if ! command -v uv >/dev/null 2>&1; then
    echo "web: uv is required (https://docs.astral.sh/uv/)" >&2
    exit 1
fi
UV_PROJECT_ENVIRONMENT="${AGENT_WEB_VENV:-$root/.venv-runtime}" \
    exec uv run --quiet --frozen --no-dev --project "$root" web "$@"

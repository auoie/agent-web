{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-web-hook",
            "args": ["pre-tool-use"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(web *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-web-hook",
            "args": ["pre-tool-use"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-web-hook",
            "args": ["user-prompt-submit"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(web search *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/agent-web-hook",
            "args": ["post-tool-use"]
          }
        ]
      }
    ]
  }
}
